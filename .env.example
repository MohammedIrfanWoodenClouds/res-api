PORT=5000
# Local: mongodb://127.0.0.1:27017/restaurant_billing
# Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/restaurant_billing?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/restaurant_billing
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_me
