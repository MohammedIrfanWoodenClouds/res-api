[Unit]
Description=RestoPilot API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/res-api
Environment=NODE_ENV=production
EnvironmentFile=/home/ubuntu/res-api/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
